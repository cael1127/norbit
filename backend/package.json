    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "@prisma/client": "^5.7.1",
    "redis": "^4.6.12",
    "bullmq": "^5.3.4",
    "ioredis": "^5.3.2",
